<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed because many home media servers and IPTV sources still use it.
     The app only connects to addresses the user opens; it has no backend of its own. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
