<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="mvoon_ink">#FF0A0F1C</color>
    <color name="mvoon_pearl">#FFEEF2F9</color>
    <string name="app_name">Mvoon</string>
    <string name="tagline">Every format, beautifully.</string>

    <style name="Theme.Mvoon" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mvoon_pearl</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash: the Mvoon crescent moon on deep navy in both themes, a short and calm brand moment. -->
    <style name="Theme.Mvoon.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mvoon_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mvoon</item>
    </style>

    <style name="Theme.Mvoon.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
